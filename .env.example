PORT=3000

# Razorpay Dashboard > Settings > API Keys (use test keys first)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_signing_secret

# Checkout taxes and optional coupon
GST_PERCENT=18
COUPON_CODE=
COUPON_DISCOUNT_PERCENT=0
SUBSCRIPTION_TOTAL_COUNT=120

# Manual transfer fallback shown when Razorpay keys are missing
UPI_ID=
BANK_NAME=
ACCOUNT_NAME=
BANK_ACCOUNT_NUMBER=
BANK_IFSC=
WHATSAPP_NUMBER=918657877578

# Email invoices and owner payment notifications (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
OWNER_EMAIL=

# Optional admin seed. Use a unique password with at least 12 characters.
# Regular customers can register from /login.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Optional SQLite location; relative paths are resolved from the project data folder.
# DB_PATH=multifly.db
